# Slack App設定 (https://api.slack.com/apps でアプリを作成)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Anthropic API (https://console.anthropic.com でAPIキーを取得)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# 任意: 使用するClaudeモデル (既定: claude-opus-4-8)
CLAUDE_MODEL=claude-opus-4-8

# 任意: タイムゾーン (既定: Asia/Tokyo)
TIMEZONE=Asia/Tokyo

# Googleカレンダー (OAuth / 個人アカウント)
# credentials.json = Google Cloud Console で作成したOAuthクライアント(デスクトップ)
# token.json = `python authorize.py` で初回認可後に自動生成
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# 操作対象カレンダー (既定: primary)
GOOGLE_CALENDAR_ID=primary
