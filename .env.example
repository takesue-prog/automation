# Slack App設定 (https://api.slack.com/apps でアプリを作成)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Anthropic API (https://console.anthropic.com でAPIキーを取得)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# 任意: AIへの指示 (システムプロンプト)
SYSTEM_PROMPT=あなたはSlackの自動返信アシスタントです。ユーザーの質問に簡潔かつ丁寧に日本語で回答してください。

# 契約報告チャンネル名 (# は不要)
CONTRACT_CHANNEL_NAME=repitte-beauty-contract

# 処理済み・無視を示すリアクション名 (コロンなし、カンマ区切りで複数指定可)
PROCESSED_REACTIONS=武居_済み,無視

# 未処理検索対象日数
UNPROCESSED_SEARCH_DAYS=30

# Google Sheets連携 (スタンプ自動反映)
# GCPサービスアカウントのJSONキーファイルパス
GOOGLE_CREDENTIALS_PATH=credentials.json
# スプレッドシートID (URLの /d/ と /edit の間)
SPREADSHEET_ID=1dA7ByXoFeA74GQfVO0eoeFJY-tJ4mLTjD2Bthvv0_Tk
# シート名 (空白にすると「7月」等の今月タブを自動検索)
GOOGLE_SHEET_NAME=
# データが入っている列番号 (1=A, 2=B, …)
GOOGLE_DATA_COLUMN=2
